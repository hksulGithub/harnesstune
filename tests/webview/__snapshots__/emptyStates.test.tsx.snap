exports[`empty workspace panels renders instructional copy for agents, runs, topology, and schematic empty states 1`] = `"<div><div><div class="workspace-header"><h2 class="workspace-header-title">ws-empty</h2><p class="workspace-header-sub">0 agents</p></div><div class="cost-summary-bar"><span class="cost-label">Workspace Total:</span><span class="cost-value">$0.00</span><span class="cost-trend flat">→</span><span class="cost-tokens">(0 tokens)</span></div><div class="fleet-empty"><h2>No agents connected yet</h2><p>Run <code>scripts/install-collector.sh</code> on a machine to see it here.</p></div></div><div><div class="agent-detail-header"><h2 class="agent-detail-title">No Agent</h2><p class="agent-detail-sub">in ws-empty</p></div><div class="cost-summary-bar"><span class="cost-label">Agent Total:</span><span class="cost-value">$0.00</span><span class="cost-trend flat">→</span><span class="cost-tokens">(0 tokens)</span></div><div class="fleet-empty"><h2>No runs recorded</h2><p>Runs appear here once an agent executes a task.</p></div></div><div class="graph-area"><div class="empty-state"><h2>Topology will render once at least one agent is connected.</h2><p>Schematic will render once an agent reports its task graph.</p></div></div></div>"`;
