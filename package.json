{
  "name": "harnesstune",
  "displayName": "HarnessTune",
  "description": "Agent Harness Engineering IDE",
  "version": "0.1.0",
  "publisher": "harnesstune",
  "repository": {
    "type": "git",
    "url": "https://github.com/hksulGithub/harnesstune.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "harnesstune.connectWorkspace",
        "title": "Connect Workspace",
        "category": "HarnessTune"
      },
      {
        "command": "harnesstune.removeWorkspace",
        "title": "Remove Workspace",
        "category": "HarnessTune"
      },
      {
        "command": "harnesstune.openWorkspace",
        "title": "Open Workspace",
        "category": "HarnessTune"
      },
      {
        "command": "harnesstune.refreshSidebar",
        "title": "Refresh Sidebar",
        "category": "HarnessTune"
      },
      {
        "command": "harnesstune.showDashboard",
        "title": "Show Dashboard",
        "category": "HarnessTune"
      },
      {
        "command": "harnesstune.pauseAgent",
        "title": "Pause Agent",
        "category": "HarnessTune"
      },
      {
        "command": "harnesstune.resumeAgent",
        "title": "Resume Agent",
        "category": "HarnessTune"
      },
      {
        "command": "harnesstune.stopAgent",
        "title": "Stop Agent",
        "category": "HarnessTune"
      },
      {
        "command": "harnesstune.showSchematic",
        "title": "Show Agent Schematic",
        "category": "HarnessTune"
      },
      {
        "command": "harnesstune.openTerminal",
        "title": "Open Terminal",
        "category": "HarnessTune"
      },
      {
        "command": "harnesstune.createWorkspace",
        "title": "Create Workspace",
        "category": "HarnessTune"
      },
      {
        "command": "harnesstune.configureWorkspace",
        "title": "Configure Workspace",
        "category": "HarnessTune"
      },
      {
        "command": "harnesstune.interruptChat",
        "title": "Interrupt Chat Session",
        "category": "HarnessTune"
      },
      {
        "command": "harnesstune.addRemoteWorkspace",
        "title": "Add Remote Workspace",
        "category": "HarnessTune"
      },
      {
        "command": "harnesstune.messageAgent",
        "title": "Message Agent",
        "category": "HarnessTune"
      },
      {
        "command": "harnesstune.configureRemoteWorkspace",
        "title": "Configure Remote Workspace",
        "category": "HarnessTune"
      },
      {
        "command": "harnesstune.openReports",
        "title": "Open Reports",
        "category": "HarnessTune"
      }
    ],
    "keybindings": [
      {
        "command": "harnesstune.interruptChat",
        "key": "escape",
        "when": "activeWebviewPanelId == 'harnesstune.chat'"
      }
    ],
    "configuration": {
      "title": "HarnessTune",
      "properties": {
        "harnesstune.dangerouslySkipPermissions": {
          "type": "boolean",
          "default": false,
          "description": "Pass --dangerously-skip-permissions to Claude Code terminal sessions. Skips all permission prompts.",
          "scope": "resource"
        }
      }
    },
    "webviewPanelSerializer": [
      {
        "viewType": "harnesstune.dashboard"
      },
      {
        "viewType": "harnesstune.schematic"
      },
      {
        "viewType": "harnesstune.reports"
      },
      {
        "viewType": "harnesstune.chat"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "harnesstune-sidebar",
          "title": "HarnessTune",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "harnesstune-sidebar": [
        {
          "type": "webview",
          "id": "harnesstune.sidebarView",
          "name": "Workspaces"
        }
      ]
    }
  },
  "scripts": {
    "build:packages": "tsc --build packages/shared packages/harnesstune-relay packages/harnesstune-agent packages/harnesstune-collector",
    "build": "pnpm run build:packages && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "vsce package --no-dependencies",
    "test": "jest --passWithNoTests",
    "test:uat": "UAT_RELAY_URL=http://127.0.0.1:18787/api UAT_DB_PATH=$PWD/.uat-tmp/uat-relay.db UAT_SEED_SCRIPT=$PWD/packages/harnesstune-relay/seed-payload.mjs UAT_POPULATED_TOKEN=uat-token-ws-populated UAT_EMPTY_TOKEN=uat-token-ws-empty jest tests/integration --runInBand"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.24.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@harnesstune/shared": "workspace:*",
    "chokidar": "^4.0.3",
    "cron-parser": "^5.5.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.14.1"
  }
}
